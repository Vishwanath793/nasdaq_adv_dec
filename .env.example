# Copy to .env (never commit .env). Every key is OPTIONAL and FREE — no payment card, no trial.
# Without keys the app runs the deterministic DEMO session and REPLAY; Nasdaq Trader and FINRA files need no key.

# Alpaca free "Basic" market data + paper trading account (https://alpaca.markets → Paper account → API keys)
# Enables LIVE LIMITED-COVERAGE (IEX real-time), SIP history ≥15 min old, calendar, shortability flags.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# round_lots (historical Alpaca default) or shares — run `npm run probe`; it reports which one your account returns.
ALPACA_QUOTE_SIZE_UNIT=round_lots
# ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# Finnhub free key (company news, profile, earnings calendar) — https://finnhub.io/register
FINNHUB_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with YOUR contact e-mail (fair access ≤10 req/s)
# Example format: "Your Name your.email@example.com"
SEC_USER_AGENT=

# Alpha Vantage free key (earnings calendar with consensus; 25 requests/day) — https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Massive (formerly Polygon.io) free Stocks Basic key (end-of-day historical aggregates; 5 calls/min)
MASSIVE_API_KEY=
# MASSIVE_BASE_URL=https://api.massive.com

# FRED free key (display-only macro context)
FRED_API_KEY=

# Server port (UI dev server proxies /api to it)
PORT=3101
